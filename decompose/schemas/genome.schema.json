{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://copilot.github.com/skills/decompose/genome.schema.json",
  "title": "Task Genome",
  "description": "Agent-executable execution plan produced by the decompose skill.",
  "type": "object",
  "required": [
    "genome_id",
    "schema_version",
    "role",
    "intent",
    "nodes",
    "edges",
    "assumptions",
    "unknowns",
    "blind_spots",
    "open_questions",
    "meta",
    "handoff"
  ],
  "additionalProperties": false,
  "properties": {
    "genome_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Edge"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "(assumption|unknown|risk|gate|human decision gate)"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "created_at",
        "session_id",
        "question_count"
      ],
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "question_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "instructions",
        "start_node"
      ],
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "start_node": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "description",
        "prompt_template",
        "inputs",
        "outputs",
        "acceptance_criteria",
        "assumptions",
        "unknowns",
        "confidence",
        "risk",
        "parallelizable_with",
        "owner_hint",
        "human_decision_gate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "research",
            "decision",
            "code_change",
            "comms",
            "review",
            "risk",
            "unknown",
            "milestone"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "parallelizable_with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_hint": {
          "type": "string",
          "minLength": 1
        },
        "human_decision_gate": {
          "type": "boolean"
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "blocks",
            "informs",
            "optional"
          ]
        }
      }
    }
  }
}
